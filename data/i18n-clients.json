 "patterns": [
  {
   "re": "^(\\d+) productes$",
   "t": {
    "es": "$1 productos",
    "en": "$1 products",
    "uk": "$1 {pl:$1:товар|товари|товарів}"
   }
  },
  {
   "re": "^(\\d+) producte$",
   "t": {
    "es": "$1 producto",
    "en": "$1 product",
    "uk": "$1 товар"
   }
  },
  {
   "re": "^🔧 (\\d+) variants$",
   "t": {
    "es": "🔧 $1 variantes",
    "en": "🔧 $1 options",
    "uk": "🔧 $1 {pl:$1:варіант|варіанти|варіантів}"
   }
  },
  {
   "re": "^(\\d+) llistes$",
   "t": {
    "es": "$1 listas",
    "en": "$1 lists",
    "uk": "$1 {pl:$1:список|списки|списків}"
   }
  },
  {
   "re": "^(\\d+) llista$",
   "t": {
    "es": "$1 lista",
    "en": "$1 list",
    "uk": "$1 список"
   }
  },
  {
   "re": "^(\\d+) categories · (.+)$",
   "t": {
    "es": "$1 categorías · $2",
    "en": "$1 categories · $2",
    "uk": "$1 {pl:$1:категорія|категорії|категорій} · $2"
   }
  },
  {
   "re": "^Assessor NEXE · (\\d+) de (\\d+)$",
   "t": {
    "es": "Asesor NEXE · $1 de $2",
    "en": "NEXE advisor · $1 of $2",
    "uk": "Порадник NEXE · $1 з $2"
   }
  },
  {
   "re": "^Imatge (\\d+)$",
   "t": {
    "es": "Imagen $1",
    "en": "Image $1",
    "uk": "Зображення $1"
   }
  },
  {
   "re": "^Ref\\. (.+)$",
   "t": {
    "es": "Ref. $1",
    "en": "Ref. $1",
    "uk": "Арт. $1"
   }
  },
  {
   "re": "^(\\d+)% confiança$",
   "t": {
    "es": "$1% de confianza",
    "en": "$1% match",
    "uk": "збіг $1%"
   }
  },
  {
   "re": "^Compatible amb (.+)\\.$",
   "t": {
    "es": "Compatible con $1.",
    "en": "Compatible with $1.",
    "uk": "Сумісно з: $1."
   }
  },
  {
   "re": "^Nivell (.+)\\.$",
   "t": {
    "es": "Nivel $T1.",
    "en": "Level: $T1.",
    "uk": "Рівень: $T1."
   }
  },
  {
   "re": "^Requereix (.+)\\.$",
   "t": {
    "es": "Requiere $T1.",
    "en": "Requires: $T1.",
    "uk": "Потрібно: $T1."
   }
  }
 ]
